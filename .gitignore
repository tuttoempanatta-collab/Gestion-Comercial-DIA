# Root gitignore
node_modules/
.env
.DS_Store
dist/
build/
.next/
*.log

# Backend specific
backend/node_modules/
backend/.env
backend/*.sqlite
backend/screenshots/
backend/playwright_data/*
!backend/playwright_data/mot_session/
backend/playwright_data/mot_session/*
!backend/playwright_data/mot_session/storage_state.json
backend/backups/pre_restore_archives/

# Frontend specific
frontend/node_modules/
frontend/.env
frontend/.next/
frontend/out/
